{
  "name": "metal-swan-3",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Original arcade run-and-gun shooter (TypeScript + Vite). All art and audio are generated by code, except ElevenLabs-generated audio for the start screens and mission ams (2026-10-14; the synth stays the fallback).",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "sprites": "tsx tools/sprites.ts",
    "shot": "tsx tools/shot.ts",
    "arena": "tsx tools/arena.ts",
    "sim": "tsx tools/sim.ts",
    "smoke": "tsx tools/smoke.ts",
    "cache-check": "tsx tools/cache-check.ts",
    "audio": "tsx tools/lib/audio-report.ts",
    "audio:gen": "tsx tools/elevenlabs.ts",
    "audio:process": "tsx tools/audio/process.ts",
    "audio:review": "tsx tools/audio/review.ts",
    "audio:ship": "tsx tools/audio/ship.ts",
    "audio:mayor-placeholders": "tsx tools/audio/mayor-placeholders.ts",
    "perf": "tsx tools/perf.ts",
    "anim-bench": "tsx tools/anim-bench.ts",
    "geometry-fixture": "tsx tools/geometry-fixture.ts",
    "art:import-face": "tsx tools/art/import-face.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
